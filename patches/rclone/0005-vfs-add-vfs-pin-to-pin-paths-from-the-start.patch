+// Pins given in the options protect files from the clean-up at startup
+func TestVFSPinOptionSurvivesStartupClean(t *testing.T) {
+	ctx := context.Background()
+	r := fstest.NewRun(t)
+	opt := offlineTestOpt()
+	r.WriteObject(ctx, "pinned/file", "pinned contents", t1)
+	r.WriteObject(ctx, "other/file", "other contents", t1)
+
+	vfs := New(ctx, r.Fremote, &opt)
+	for _, name := range []string{"pinned/file", "other/file"} {
+		_, err := vfs.ReadFile(name)
+		require.NoError(t, err)
+	}
+	vfs.WaitForWriters(waitForWritersDelay)
+	vfs.Shutdown()
+	time.Sleep(10 * time.Millisecond)
+
+	// Everything is older than the max age, so the startup clean removes
+	// every item that isn't pinned
+	opt.CacheMaxAge = fs.Duration(time.Millisecond)
+	opt.Pin = []string{"pinned"}
+	vfs = New(ctx, r.Fremote, &opt)
+	t.Cleanup(func() { cleanupVFS(t, vfs) })
+	require.Eventually(t, func() bool { return !vfs.cache.Exists("other/file") }, 5*time.Second, 10*time.Millisecond)
+	assert.True(t, vfs.cache.Exists("pinned/file"))
+	assert.Equal(t, []string{"pinned"}, vfs.cache.Pins())
+}
