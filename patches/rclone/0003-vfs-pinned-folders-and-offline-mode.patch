diff --git a/vfs/offline_test.go b/vfs/offline_test.go
new file mode 100644
index 0000000..f91ae75
--- /dev/null
+++ b/vfs/offline_test.go
@@ -0,0 +1,247 @@
+package vfs
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/rc"
+	"github.com/rclone/rclone/fstest"
+	"github.com/rclone/rclone/vfs/vfscache"
+	"github.com/rclone/rclone/vfs/vfscommon"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+var errUnreachable = errors.New("remote unreachable")
+
+// unreachableFs is a remote which can't be listed or looked up while
+// unreachable is set, like a cloud remote with no network.
+type unreachableFs struct {
+	fs.Fs
+	unreachable atomic.Bool
+}
+
+func (f *unreachableFs) List(ctx context.Context, dir string) (fs.DirEntries, error) {
+	if f.unreachable.Load() {
+		return nil, errUnreachable
+	}
+	return f.Fs.List(ctx, dir)
+}
+
+func (f *unreachableFs) NewObject(ctx context.Context, remote string) (fs.Object, error) {
+	if f.unreachable.Load() {
+		return nil, errUnreachable
+	}
+	return f.Fs.NewObject(ctx, remote)
+}
+
+// offlineTestOpt returns options for a full cache whose files are
+// closed straight away so another VFS can load them
+func offlineTestOpt() vfscommon.Options {
+	opt := vfscommon.Opt
+	opt.CacheMode = vfscommon.CacheModeFull
+	opt.HandleCaching = 0
+	return opt
+}
+
+// list dir as "name size isDir" strings
+func offlineReadDir(t *testing.T, vfs *VFS, dir string) []string {
+	fis, err := vfs.ReadDir(dir)
+	require.NoError(t, err)
+	var out []string
+	for _, fi := range fis {
+		out = append(out, fmt.Sprintf("%s %d %v", fi.Name(), fi.Size(), fi.IsDir()))
+	}
+	return out
+}
+
+// newRestartedOfflineVFS caches some files of dir with one VFS and
+// returns a second VFS on the same cache, as after a restart, whose
+// remote is unreachable and whose cache is offline.
+func newRestartedOfflineVFS(t *testing.T) (*fstest.Run, *unreachableFs, *VFS) {
+	ctx := context.Background()
+	r := fstest.NewRun(t)
+	opt := offlineTestOpt()
+	r.WriteObject(ctx, "dir/cached", "cached contents", t1)
+	r.WriteObject(ctx, "dir/sub/deep", "deep contents", t1)
+	r.WriteObject(ctx, "dir/uncached", "uncached contents", t1)
+
+	vfs := New(ctx, r.Fremote, &opt)
+	for _, name := range []string{"dir/cached", "dir/sub/deep"} {
+		_, err := vfs.ReadFile(name)
+		require.NoError(t, err)
+	}
+	vfs.WaitForWriters(waitForWritersDelay)
+	vfs.Shutdown()
+
+	f := &unreachableFs{Fs: r.Fremote}
+	f.unreachable.Store(true)
+	vfs = New(ctx, f, &opt)
+	t.Cleanup(func() { cleanupVFS(t, vfs) })
+	vfs.cache.SetOffline(true)
+	return r, f, vfs
+}
+
+// A directory never listed shows its cached files while offline
+func TestVFSOfflineAfterRestart(t *testing.T) {
+	_, _, vfs := newRestartedOfflineVFS(t)
+
+	start := time.Now()
+	assert.Equal(t, []string{"cached 15 false", "sub 0 true"}, offlineReadDir(t, vfs, "dir"))
+
+	b, err := vfs.ReadFile("dir/cached")
+	require.NoError(t, err)
+	assert.Equal(t, "cached contents", string(b))
+	b, err = vfs.ReadFile("dir/sub/deep")
+	require.NoError(t, err)
+	assert.Equal(t, "deep contents", string(b))
+
+	_, err = vfs.ReadFile("dir/uncached")
+	assert.Equal(t, ENOENT, err)
+	assert.Less(t, time.Since(start), time.Second)
+}
+
+// Entries listed while offline are replaced by a real listing once online
+func TestVFSOfflineBackOnline(t *testing.T) {
+	r, f, vfs := newRestartedOfflineVFS(t)
+	ctx := context.Background()
+
+	assert.Equal(t, []string{"cached 15 false", "sub 0 true"}, offlineReadDir(t, vfs, "dir"))
+	_, err := vfs.ReadFile("dir/cached")
+	require.NoError(t, err)
+
+	obj, err := r.Fremote.NewObject(ctx, "dir/cached")
+	require.NoError(t, err)
+	require.NoError(t, obj.Remove(ctx))
+
+	f.unreachable.Store(false)
+	vfs.cache.SetOffline(false)
+	assert.Equal(t, []string{"sub 0 true", "uncached 17 false"}, offlineReadDir(t, vfs, "dir"))
+
+	b, err := vfs.ReadFile("dir/uncached")
+	require.NoError(t, err)
+	assert.Equal(t, "uncached contents", string(b))
+}
+
+// A cached symlink listed while offline is the same node each listing
+func TestVFSOfflineLinks(t *testing.T) {
+	ctx := context.Background()
+	r := fstest.NewRun(t)
+	opt := offlineTestOpt()
+	opt.Links = true
+	r.WriteObject(ctx, "dir/link"+fs.LinkSuffix, "target", t1)
+
+	vfs := New(ctx, r.Fremote, &opt)
+	target, err := vfs.Readlink("dir/link")
+	require.NoError(t, err)
+	assert.Equal(t, "target", target)
+	vfs.WaitForWriters(waitForWritersDelay)
+	vfs.Shutdown()
+
+	vfs = New(ctx, r.Fremote, &opt)
+	t.Cleanup(func() { cleanupVFS(t, vfs) })
+	vfs.cache.SetOffline(true)
+
+	node1, err := vfs.Stat("dir/link")
+	require.NoError(t, err)
+	node2, err := vfs.Stat("dir/link")
+	require.NoError(t, err)
+	assert.Equal(t, node1.Inode(), node2.Inode())
+	target, err = vfs.Readlink("dir/link")
+	require.NoError(t, err)
+	assert.Equal(t, "target", target)
+}
+
+// Reading data which isn't cached fails straight away while offline
+func TestVFSOfflineReadUncached(t *testing.T) {
+	opt := offlineTestOpt()
+	r, vfs := newTestVFSOpt(t, &opt)
+	r.WriteObject(context.Background(), "file", "file contents", t1)
+	_, err := vfs.Stat("file")
+	require.NoError(t, err)
+
+	vfs.cache.SetOffline(true)
+	start := time.Now()
+	_, err = vfs.ReadFile("file")
+	assert.ErrorIs(t, err, vfscache.ErrOffline)
+	assert.Less(t, time.Since(start), time.Second)
+
+	vfs.cache.SetOffline(false)
+	b, err := vfs.ReadFile("file")
+	require.NoError(t, err)
+	assert.Equal(t, "file contents", string(b))
+}
+
+func TestRcPin(t *testing.T) {
+	opt := offlineTestOpt()
+	r, vfs := newTestVFSOpt(t, &opt)
+	call := rc.Calls.Get("vfs/pin")
+	require.NotNil(t, call)
+
+	pin := func(in rc.Params) (rc.Params, error) {
+		in["fs"] = fs.ConfigString(r.Fremote)
+		return call.Fn(context.Background(), in)
+	}
+	out, err := pin(rc.Params{})
+	require.NoError(t, err)
+	assert.Equal(t, rc.Params{"pins": []string{}}, out)
+
+	out, err = pin(rc.Params{"add": "a/b"})
+	require.NoError(t, err)
+	assert.Equal(t, rc.Params{"pins": []string{"a/b"}}, out)
+
+	out, err = pin(rc.Params{"add": "/c/"})
+	require.NoError(t, err)
+	assert.Equal(t, rc.Params{"pins": []string{"a/b", "c"}}, out)
+
+	out, err = pin(rc.Params{"remove": "a/b"})
+	require.NoError(t, err)
+	assert.Equal(t, rc.Params{"pins": []string{"c"}}, out)
+	assert.Equal(t, []string{"c"}, vfs.cache.Pins())
+
+	_, err = pin(rc.Params{"dir": "a"})
+	assert.ErrorContains(t, err, "invalid parameter")
+}
+
+func TestRcOffline(t *testing.T) {
+	opt := offlineTestOpt()
+	r, vfs := newTestVFSOpt(t, &opt)
+	call := rc.Calls.Get("vfs/offline")
+	require.NotNil(t, call)
+
+	offline := func(in rc.Params) (rc.Params, error) {
+		in["fs"] = fs.ConfigString(r.Fremote)
+		return call.Fn(context.Background(), in)
+	}
+	out, err := offline(rc.Params{})
+	require.NoError(t, err)
+	assert.Equal(t, rc.Params{"offline": false}, out)
+
+	out, err = offline(rc.Params{"offline": true})
+	require.NoError(t, err)
+	assert.Equal(t, rc.Params{"offline": true}, out)
+	assert.True(t, vfs.cache.Offline())
+
+	out, err = offline(rc.Params{"offline": "false"})
+	require.NoError(t, err)
+	assert.Equal(t, rc.Params{"offline": false}, out)
+	assert.False(t, vfs.cache.Offline())
+
+	_, err = offline(rc.Params{"offline": "maybe"})
+	assert.Error(t, err)
+}
+
+func TestRcPinOfflineNoCache(t *testing.T) {
+	r, _ := newTestVFS(t)
+	for _, method := range []string{"vfs/pin", "vfs/offline"} {
+		call := rc.Calls.Get(method)
+		require.NotNil(t, call)
+		_, err := call.Fn(context.Background(), rc.Params{"fs": fs.ConfigString(r.Fremote)})
+		assert.ErrorContains(t, err, "VFS cache", method)
+	}
+}
diff --git a/vfs/rc.go b/vfs/rc.go
index e45b0b3..2f74773 100644
--- a/vfs/rc.go
+++ b/vfs/rc.go
@@ -578,3 +578,122 @@ func rcQueueSetExpiry(ctx context.Context, in rc.Params) (out rc.Params, err err
 	err = vfs.cache.QueueSetExpiry(writeback.Handle(id), refTime, time.Duration(float64(time.Second)*expiry))
 	return nil, err
 }
+
+func init() {
+	rc.Add(rc.Call{
+		Path:  "vfs/pin",
+		Title: "Keep files in the VFS cache.",
+		Help: strings.ReplaceAll(`
+This pins a directory or file so that the items in the VFS cache under
+it are never removed by the cache cleaner. Pinned items don't count
+towards |--vfs-cache-max-size|.
+
+Pinning doesn't download anything - files are cached when they are
+read. Pins are kept in memory so need adding again after a restart.
+
+    rclone rc vfs/pin add=path/to/dir
+
+This takes the following parameters
+
+- |fs| - select the VFS in use (optional)
+- |add| - a path relative to the root of the remote to pin (optional)
+- |remove| - a path to unpin (optional)
+
+It returns the sorted list of pinned paths
+
+    {
+        "pins": ["path/to/dir"]
+    }
+
+This will return an error if called with |--vfs-cache-mode| off.
+
+`, "|", "`") + getVFSHelp,
+		Fn: rcPin,
+	})
+}
+
+func rcPin(ctx context.Context, in rc.Params) (out rc.Params, err error) {
+	vfs, err := getVFS(in)
+	if err != nil {
+		return nil, err
+	}
+	if vfs.cache == nil {
+		return nil, rc.NewErrParamInvalid(errors.New("can't call this unless using the VFS cache"))
+	}
+	add, addErr := in.GetString("add")
+	remove, removeErr := in.GetString("remove")
+	for _, err := range []error{addErr, removeErr} {
+		if err != nil && !rc.IsErrParamNotFound(err) {
+			return nil, err
+		}
+	}
+	delete(in, "add")
+	delete(in, "remove")
+	for k, v := range in {
+		return nil, fmt.Errorf("invalid parameter: %s=%v", k, v)
+	}
+	if addErr == nil {
+		vfs.cache.Pin(add)
+	}
+	if removeErr == nil {
+		vfs.cache.Unpin(remove)
+	}
+	return rc.Params{"pins": vfs.cache.Pins()}, nil
+}
+
+func init() {
+	rc.Add(rc.Call{
+		Path:  "vfs/offline",
+		Title: "Get or set whether the VFS cache is offline.",
+		Help: strings.ReplaceAll(`
+While offline, data which isn't in the VFS cache is never downloaded,
+so reading it fails straight away rather than retrying the remote.
+
+Directories without an up to date listing in the directory cache are
+listed from the VFS cache instead, showing the files which are wholly
+in the cache and the directories holding them. These entries are
+replaced by a listing of the remote the next time the directory is
+read once back online.
+
+    rclone rc vfs/offline offline=true
+
+This takes the following parameters
+
+- |fs| - select the VFS in use (optional)
+- |offline| - true to go offline, false to go back online (optional)
+
+It returns the current state
+
+    {
+        "offline": true
+    }
+
+This will return an error if called with |--vfs-cache-mode| off.
+
+`, "|", "`") + getVFSHelp,
+		Fn: rcOffline,
+	})
+}
+
+func rcOffline(ctx context.Context, in rc.Params) (out rc.Params, err error) {
+	vfs, err := getVFS(in)
+	if err != nil {
+		return nil, err
+	}
+	if vfs.cache == nil {
+		return nil, rc.NewErrParamInvalid(errors.New("can't call this unless using the VFS cache"))
+	}
+	offline, err := in.GetBool("offline")
+	found := err == nil
+	if err != nil && !rc.IsErrParamNotFound(err) {
+		return nil, err
+	}
+	delete(in, "offline")
+	for k, v := range in {
+		return nil, fmt.Errorf("invalid parameter: %s=%v", k, v)
+	}
+	if found {
+		vfs.cache.SetOffline(offline)
+	}
+	return rc.Params{"offline": vfs.cache.Offline()}, nil
+}
