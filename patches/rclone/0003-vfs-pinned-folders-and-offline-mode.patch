+// ErrOffline is returned when data which isn't in the cache is needed
+// while the cache is offline.
+var ErrOffline = errors.New("vfs cache: offline and data not in cache")
+
+// SetOffline sets whether the cache is offline.
+//
+// While offline, data which isn't in the cache is never downloaded and
+// ErrOffline is returned instead.
+func (c *Cache) SetOffline(offline bool) {
+	c.offline.Store(offline)
+}
+
+// Offline returns whether the cache is offline, see SetOffline
+func (c *Cache) Offline() bool {
+	return c.offline.Load()
+}
+
+// Pin stops the cache cleaner removing the item called name or any
+// items in the directory called name.
+//
+// Pinned items don't count towards the maximum cache size.
+//
+// name should be a remote path not an osPath
+func (c *Cache) Pin(name string) {
+	c.pinMu.Lock()
+	c.pins[clean(name)] = struct{}{}
+	c.pinMu.Unlock()
+}
+
+// Unpin removes a pin added by Pin
+//
+// name should be a remote path not an osPath
+func (c *Cache) Unpin(name string) {
+	c.pinMu.Lock()
+	delete(c.pins, clean(name))
+	c.pinMu.Unlock()
+}
+
+// Pins returns the sorted names added by Pin
+func (c *Cache) Pins() []string {
+	c.pinMu.Lock()
+	defer c.pinMu.Unlock()
+	pins := make([]string, 0, len(c.pins))
+	for name := range c.pins {
+		pins = append(pins, name)
+	}
+	sort.Strings(pins)
+	return pins
+}
+
+// isPinned returns whether name or any of its parents are pinned
+//
+// name should be a cleaned remote path as used in the index map
+func (c *Cache) isPinned(name string) bool {
+	c.pinMu.Lock()
