diff --git a/vfs/vfscache/pin_test.go b/vfs/vfscache/pin_test.go
new file mode 100644
index 0000000..90bcc88
--- /dev/null
+++ b/vfs/vfscache/pin_test.go
@@ -0,0 +1,189 @@
+package vfscache
+
+import (
+	"sort"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// write contents to a new item called name and close it
+func itemWriteClose(t *testing.T, c *Cache, name, contents string) *Item {
+	item := c.Item(name)
+	itemWrite(t, item, contents)
+	require.NoError(t, item.Close(nil))
+	return item
+}
+
+// read all of the open item and check it holds contents
+func itemReadAll(t *testing.T, item *Item, contents string) {
+	buf := make([]byte, len(contents))
+	_, err := item.ReadAt(buf, 0)
+	require.NoError(t, err)
+	assert.Equal(t, contents, string(buf))
+}
+
+func TestCachePins(t *testing.T) {
+	_, c := newTestCache(t)
+
+	assert.Equal(t, []string{}, c.Pins())
+
+	c.Pin("/a/b/")
+	c.Pin("c")
+	c.Pin("c")
+	assert.Equal(t, []string{"a/b", "c"}, c.Pins())
+
+	assert.True(t, c.isPinned("a/b"))
+	assert.True(t, c.isPinned("a/b/file"))
+	assert.True(t, c.isPinned("c/d/e"))
+	assert.False(t, c.isPinned("a"))
+	assert.False(t, c.isPinned("a/bc"))
+	assert.False(t, c.isPinned("d"))
+
+	c.Unpin("a/b/")
+	c.Unpin("notpinned")
+	assert.Equal(t, []string{"c"}, c.Pins())
+	assert.False(t, c.isPinned("a/b/file"))
+
+	c.Pin("")
+	assert.True(t, c.isPinned("d"))
+}
+
+func TestCachePinPurgeOld(t *testing.T) {
+	_, c := newTestCache(t)
+
+	for _, name := range []string{"pinned/potato", "pinned/sub/potato2", "pinnedx/potato3", "other/potato4"} {
+		itemWriteClose(t, c, name, "hello")
+	}
+	c.Pin("pinned")
+
+	c.purgeOld(-10 * time.Second)
+	assert.Equal(t, []string{
+		`name="pinned/potato" opens=0 size=5`,
+		`name="pinned/sub/potato2" opens=0 size=5`,
+	}, itemAsString(c))
+
+	c.Unpin("pinned")
+	c.purgeOld(-10 * time.Second)
+	assert.Equal(t, []string(nil), itemAsString(c))
+}
+
+func TestCachePinPurgeOverQuota(t *testing.T) {
+	_, c := newTestCache(t)
+
+	pinned := itemWriteClose(t, c, "pinned/potato", "hello")
+	other := itemWriteClose(t, c, "other/potato2", "hello2")
+	c.Pin("pinned")
+	c.updateUsed()
+
+	// The 5 pinned bytes don't count towards the 11 bytes used
+	c.opt.CacheMaxSize = 6
+	c.mu.Lock()
+	assert.True(t, c.quotasOK())
+	c.opt.CacheMaxSize = 5
+	assert.False(t, c.quotasOK())
+	c.mu.Unlock()
+
+	// The unpinned item goes even though the pinned one is older
+	pinned.info.ATime = time.Now().Add(-time.Hour)
+	other.info.ATime = time.Now()
+	c.opt.CacheMaxSize = 1
+	c.purgeOverQuota()
+	assert.Equal(t, []string{
+		`name="pinned/potato" opens=0 size=5`,
+	}, itemAsString(c))
+	assert.Equal(t, int64(5), c.used)
+}
+
+func TestCachePinPurgeClean(t *testing.T) {
+	r, c := newItemTestCache(t)
+
+	pinnedContents, pinnedObj, pinned := newFile(t, r, c, "pinned/existing")
+	otherContents, otherObj, other := newFile(t, r, c, "other/existing")
+	require.NoError(t, pinned.Open(pinnedObj))
+	require.NoError(t, other.Open(otherObj))
+	itemReadAll(t, pinned, pinnedContents)
+	itemReadAll(t, other, otherContents)
+	c.Pin("pinned")
+
+	// The open unpinned item is reset even though the pinned one is older
+	pinned.info.ATime = time.Now().Add(-time.Hour)
+	other.info.ATime = time.Now()
+	c.updateUsed()
+	c.opt.CacheMaxSize = 1
+	c.purgeClean()
+	assert.Equal(t, []string{
+		`name="other/existing" opens=1 size=100 space=0`,
+		`name="pinned/existing" opens=1 size=100 space=100`,
+	}, itemSpaceAsString(c))
+
+	require.NoError(t, pinned.Close(nil))
+	require.NoError(t, other.Close(nil))
+}
+
+func TestCacheDirList(t *testing.T) {
+	r, c := newItemTestCache(t)
+
+	// Fully downloaded files
+	for _, name := range []string{"dir/full", "dir/sub/deep", "dir/link.rclonelink"} {
+		contents, obj, item := newFile(t, r, c, name)
+		require.NoError(t, item.Open(obj))
+		itemReadAll(t, item, contents)
+		require.NoError(t, item.Close(nil))
+	}
+
+	// Files opened but not downloaded
+	for _, name := range []string{"dir/notdownloaded", "dir/sub2/notdownloaded"} {
+		_, obj, item := newFile(t, r, c, name)
+		require.NoError(t, item.Open(obj))
+		require.NoError(t, item.Close(nil))
+	}
+
+	// A file written locally and an item with no cache file
+	itemWriteClose(t, c, "dir/written", "hello")
+	c.Item("dir/placeholder")
+
+	dirList := func(dir string) []DirListEntry {
+		entries := c.DirList(dir)
+		sort.Slice(entries, func(i, j int) bool { return entries[i].Leaf < entries[j].Leaf })
+		return entries
+	}
+	assert.Equal(t, []DirListEntry{
+		{Leaf: "full", Size: 100},
+		{Leaf: "link.rclonelink", Size: 100},
+		{Leaf: "sub", IsDir: true},
+		{Leaf: "written", Size: 5},
+	}, dirList("dir"))
+	assert.Equal(t, []DirListEntry{{Leaf: "dir", IsDir: true}}, dirList(""))
+	assert.Equal(t, []DirListEntry{{Leaf: "deep", Size: 100}}, dirList("/dir/sub/"))
+	assert.Equal(t, []DirListEntry(nil), dirList("dir/sub2"))
+	assert.Equal(t, []DirListEntry(nil), dirList("nothing"))
+}
+
+func TestItemReadAtOffline(t *testing.T) {
+	r, c := newItemTestCache(t)
+	contents, obj, item := newFile(t, r, c, "existing")
+	require.NoError(t, item.Open(obj))
+	defer func() {
+		require.NoError(t, item.Close(nil))
+	}()
+
+	assert.False(t, c.Offline())
+	c.SetOffline(true)
+	assert.True(t, c.Offline())
+
+	buf := make([]byte, len(contents))
+	start := time.Now()
+	_, err := item.ReadAt(buf, 0)
+	assert.ErrorIs(t, err, ErrOffline)
+	assert.Less(t, time.Since(start), time.Second)
+
+	c.SetOffline(false)
+	itemReadAll(t, item, contents)
+
+	// Data already in the cache can be read while offline
+	c.SetOffline(true)
+	itemReadAll(t, item, contents)
+}
