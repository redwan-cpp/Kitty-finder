<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to Config/GoogleOAuth.plist (git-ignored) and fill in your Google Cloud
  "Desktop app" OAuth client. scripts/bundle.sh builds it into the app so
  friends don't need to set anything up.
-->
<plist version="1.0">
<dict>
  <key>ClientID</key><string>1234567890-xxxxxxxx.apps.googleusercontent.com</string>
  <key>ClientSecret</key><string>GOCSPX-xxxxxxxxxxxxxxxx</string>
</dict>
</plist>
